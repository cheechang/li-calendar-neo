{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "liCalendar",
  "mainBinaryName": "liCalendar",
  "version": "../package.json",
  "identifier": "pro.softsoft.li-calendar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "松鼠日历",
        "width": 800,
        "height": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "softsoft.pro",
    "category": "Utility",
    "shortDescription": "松鼠日历",
    "longDescription": "松鼠日历",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cheechang/li-calendar-neo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3REVERDlGQzA5ODdEQzIKUldUQ2ZaakFuOTNlOTdmOTZGRkprVjY5eVVpY2t0c3ZNL28zaXNtNEUyMVdCbm9XL3FuWEVDWFkK"
    }
  }
}
